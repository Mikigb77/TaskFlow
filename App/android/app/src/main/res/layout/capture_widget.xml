<!-- A 1x1 cell is 80 dp: 6 + 24 + 44 for the label + 6. The label shrinks from 12 sp to 9 sp
     (API 26+) so two lines stay whole at large text; on API 24-25 it stays at 12 sp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/capture_widget_button" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="6dp"
    android:background="@drawable/capture_widget_background" android:contentDescription="@string/capture_widget_label">
    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/capture_mic"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/capture_widget_label" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="@string/capture_widget_label"
        android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" android:maxLines="2"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp" />
</LinearLayout>
