<?xml version="1.0" encoding="utf-8"?>
<!-- The «meeting» launcher shortcut's icon (Android 8+): the teal person speaking on
     the light mint, as an adaptive icon like the voice and text shortcuts (UX-2112).
     Android 7 uses drawable/capture_shortcut_meeting.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <color android:color="#E3F1EE" />
    </background>
    <foreground android:drawable="@drawable/capture_shortcut_meeting_foreground" />
</adaptive-icon>
