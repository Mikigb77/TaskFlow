<?xml version="1.0" encoding="utf-8"?>
<!-- The «text» launcher shortcut's icon (Android 8+): the teal pencil on the
     light mint, as an adaptive icon, so the launcher fills its own circle with
     the mint instead of shrinking a drawn disc inside a white one (UX-2112).
     Android 7 uses drawable/capture_shortcut_text.xml. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <color android:color="#E3F1EE" />
    </background>
    <foreground android:drawable="@drawable/capture_shortcut_text_foreground" />
</adaptive-icon>
