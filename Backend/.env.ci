# The settings the backend's tests run with in GitHub Actions
# (.github/workflows/backend-checks.yml and deploy-backend.yml).
# Committed on purpose: nothing here is a secret. Keys are blank or fake so no
# test can reach a paid or real service. Local development uses its own .env,
# which is never committed (copy .env.example).
DJANGO_SECRET_KEY=ci-only-not-a-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
API_PORT=8088
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=
GEMINI_API_KEY=
AI_TEXT_MODEL=gemma-4-26b-a4b-it
AI_AUDIO_MODEL=gemini-3.5-transcribe
AI_REQUESTS_PER_DAY=50
DEFAULT_TIME_ZONE=Europe/Madrid
MAILPIT_PORT=8026
PASSWORD_RESET_BASE_URL=http://localhost:8088/reset-password/
LOCAL_TEST_ACCOUNT_ENABLED=1
LOCAL_TEST_ACCOUNT_EMAIL=app-test@taskflow.local
LOCAL_TEST_ACCOUNT_PASSWORD=ci-only-test-account-password
GOOGLE_OAUTH_CLIENT_IDS=177649734578-cr3scnkukf14a1bbl7bpcj49t9aorft0.apps.googleusercontent.com
DEPLOYMENT_ENVIRONMENT=development
REVENUECAT_API_KEY=
REVENUECAT_ALLOW_SANDBOX=1
COMPLIMENTARY_PRO_EMAILS=
COMPLIMENTARY_PRO_BILLING_IDS=
