# Copy to .env and fill in private values. .env is never committed (.gitignore):
# keep it on the PC only. CI uses .env.ci; staging reads Google Secret Manager.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=0
DEPLOYMENT_ENVIRONMENT=production
# Public SDK key for server-side customer reads; never put secret keys in Flutter.
REVENUECAT_API_KEY=
# Accepted only with DEPLOYMENT_ENVIRONMENT=development.
REVENUECAT_ALLOW_SANDBOX=0
COMPLIMENTARY_PRO_EMAILS=
COMPLIMENTARY_PRO_BILLING_IDS=
# Staging only: a read-only GitHub token for the app repo's releases, so the
# staging app can update itself (core/app_updates.py). Leave empty elsewhere.
APP_UPDATE_GITHUB_TOKEN=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
API_PORT=8088
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-random-password
# AI runs only on Vertex AI, signed in with Application Default Credentials
# (scripts/login-vertex.ps1, mounted by compose.vertex.yaml). There is no API key.
AI_VERTEX_PROJECT=taskflow-511107
AI_VERTEX_LOCATION=global
AI_VERTEX_TEXT_MODEL=gemini-3.1-flash-lite
AI_VERTEX_AUDIO_MODEL=gemini-3.1-flash-lite
AI_MEETING_AUDIO_MODEL=gemini-3.5-flash-lite
AI_MEETING_TEXT_MODEL=gemini-3.5-flash-lite
AI_MEETING_PIECES_PER_MONTH=240
AI_REQUESTS_PER_DAY=50
AI_GLOBAL_REQUESTS_PER_DAY=200
# Without Pro: AI dictations per UTC calendar month, and total file storage in MiB.
FREE_VOICE_CAPTURES_PER_MONTH=10
FREE_ATTACHMENT_MB=100
DEFAULT_TIME_ZONE=Europe/Madrid
MAILPIT_PORT=8026
PASSWORD_RESET_BASE_URL=http://localhost:8088/reset-password/
# Opt in only for a local testing workspace.
LOCAL_TEST_ACCOUNT_ENABLED=0
LOCAL_TEST_ACCOUNT_EMAIL=app-test@taskflow.local
LOCAL_TEST_ACCOUNT_PASSWORD=replace-with-a-local-test-password
# Public Web OAuth client IDs accepted as Google ID token audiences (comma-separated).
# Keep empty to disable Google login until OAuth clients are configured.
GOOGLE_OAUTH_CLIENT_IDS=
