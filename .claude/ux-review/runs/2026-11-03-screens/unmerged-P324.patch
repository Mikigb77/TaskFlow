+/// A store whose closing of the last piece (at Stop) fails [failures]
+/// times, as a full disk or a busy database might.
+class _FailingLastPiece extends MeetingStore {
+  _FailingLastPiece(super.database, {super.directory});
+  int failures = 0;
+
+  @override
+  Future<bool> closePiece(
+    Meeting meeting, {
+    required int index,
+    required Duration duration,
+    required bool hasSound,
+    required DateTime now,
+    String? nextPath,
+    bool hold = false,
+  }) async {
+    if (nextPath == null && failures > 0) {
+      failures--;
+      throw StateError('The database is busy.');
+    }
+    return super.closePiece(
+      meeting,
+      index: index,
+      duration: duration,
+      hasSound: hasSound,
+      now: now,
+      nextPath: nextPath,
+      hold: hold,
+    );
+  }
+}
