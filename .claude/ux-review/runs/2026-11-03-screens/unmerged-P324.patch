+// P324 (UX-2717): what Stop keeps of a quiet recording, in the real
+// recorder, store, controller and uploader, over a fake microphone and a
+// fake server. Until a piece with sound is kept, silent pieces are held on
+// the phone, never sent; a recording of a minute or more with no sound is
+// kept at Stop to ask about; a shorter one is dropped as before; once a
+// piece with sound comes, the silent ones before it are left out (MN-4).
+//
+// These sit in their own file because meeting_core_test.dart doesn't parse
+// in this run's worktree (an earlier merge); they can move into its main()
+// as group('P324 · …') once it's repaired.
+import 'dart:io';
+
+import 'package:agenda/models/meeting.dart';
+import 'package:agenda/services/meeting_controller.dart';
+import 'package:agenda/services/meeting_note.dart';
