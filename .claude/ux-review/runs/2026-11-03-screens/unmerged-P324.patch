+// says it's still recording and works again; a recording of a minute or
+// more judged all silence asks before anything is thrown away; a shorter
+// one is still dropped with its snackbar. The meeting core is scripted
+// (ScriptedMeetings); the recorder's side is in meeting_stop_recorder_test.
+//
+// These sit in their own file because meeting_screens_test.dart doesn't
+// parse in this run's worktree (an earlier merge); they can move into its
+// main() as group('P324 · …') once it's repaired.
+import 'package:agenda/l10n/generated/app_localizations.dart';
+import 'package:agenda/models/meeting.dart';
+import 'package:agenda/screens/meeting_screen.dart';
+import 'package:agenda/screens/notes_screen.dart';
+import 'package:agenda/services/notification_service.dart';
+import 'package:agenda/theme/app_theme.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import 'support/design_fixtures.dart';
+import 'support/meeting_screen_fakes.dart';
+
+final _es = lookupAppLocalizations(const Locale('es'));
+
+/// Parar's first press throws, as a Stop that couldn't stop.
+class _FailingStop extends ScriptedMeetings {
+  int failures = 1;
+
+  @override
+  Future<Meeting?> stop() async {
+    if (failures > 0) {
+      failures--;
+      calls.stops++;
+      // Still recording: the status stays.
+      throw StateError('The recorder couldn’t stop.');
+    }
+    return super.stop();
+  }
+}
+
+/// Parar on ten minutes judged all silence: kept as a stopped meeting, its
+/// pieces held, to ask first (UX-2717).
+class _QuietStop extends ScriptedMeetings {
+  @override
+  Future<Meeting?> stop() async {
+    calls.stops++;
+    final meeting = fakeMeeting(
+      state.recording!.meetingId,
+      phase: MeetingPhase.interrupted,
+      recorded: const Duration(minutes: 10),
+    );
+    state = state.copyWith(
+      clearRecording: true,
+      stopped: [...state.stopped, meeting],
+    );
+    return meeting;
+  }
+}
+
+ProviderContainer _container(ScriptedMeetings meetings) {
+  final container = designContainer(
+    regionalStore: MemoryRegionalStore(),
+    overrides: [meetingsOverride(meetings)],
+  );
+  addTearDown(container.dispose);
+  return container;
+}
+
+/// Notes in Spanish on a small phone, then «Grabar una reunión»: recording.
+Future<void> _recording(
+  WidgetTester tester,
+  ProviderContainer container,
+) async {
+  await tester.binding.setSurfaceSize(const Size(360, 740));
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  await tester.pumpWidget(
+    UncontrolledProviderScope(
+      container: container,
